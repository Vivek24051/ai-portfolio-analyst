# Copy to .env and fill in. Never commit .env.
# Nothing here is required to build or run tests.

# ---- Data backend ----
# memory (default): in-memory stores seeded from data/original/*.csv; resets on restart.
# prisma: PostgreSQL via Prisma (run `npm run db:migrate` and `npm run db:seed` first).
DATA_BACKEND="memory"

# Required only when DATA_BACKEND=prisma. Local example (adjust user/password/port), or Neon.
# Neon: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL (migrations).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/portfolio_analyst?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/portfolio_analyst?schema=public"

# ---- Model (server-side only — never prefix with NEXT_PUBLIC_) ----
# Leave everything empty to use the dev stub (keyword router, no LLM, no cost).
#
# LLM_PROVIDER: "stub" | "gemini" | "openrouter" (or empty).
#   "stub" ALWAYS uses the dev stub, even if API keys below are set — recommended for a first
#   deployment so no model API can be called. Any unrecognised value also falls back to the stub.
#
# Google Gemini (free tier with a Google AI Studio key; keep billing disabled on its project):
#   LLM_PROVIDER="gemini"  GEMINI_API_KEY="..."  LLM_PRIMARY_MODEL="gemini-2.5-flash"
# OpenRouter (paid): set OPENROUTER_API_KEY and LLM_PRIMARY_MODEL.
LLM_PROVIDER=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
LLM_PRIMARY_MODEL=""
LLM_FALLBACK_MODEL=""
# Per model call, and for the whole chat turn (keep below the 60 s function limit).
LLM_CALL_TIMEOUT_MS="20000"
CHAT_TURN_DEADLINE_MS="50000"
CHAT_HISTORY_LIMIT="30"
# Messages per user per minute (per server instance).
CHAT_RATE_LIMIT_PER_MIN="20"
# Dev stub only: artificial per-word streaming delay in ms (demo effect). Use 0 for benchmarks.
DEV_STUB_STREAM_DELAY_MS="12"

# ---- Sessions / admin ----
# Signs the demo-user session cookie. Required in production (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# HTTP Basic auth for /admin and /api/admin. REQUIRED to use the dashboard in every environment:
# with no password (or one shorter than 12 characters) the admin surface returns 503.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
