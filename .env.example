# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Local example (adjust user/password/port), or a Neon connection string.
# Neon: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL (migrations).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/portfolio_analyst?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/portfolio_analyst?schema=public"

# OpenRouter (server-side only — never prefix with NEXT_PUBLIC_)
OPENROUTER_API_KEY=""
LLM_PRIMARY_MODEL=""
LLM_FALLBACK_MODEL=""

# Signs the demo-user session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Basic auth for /admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
