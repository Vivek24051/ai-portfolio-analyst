{
  "name": "ai-real-estate-portfolio-analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dry": "tsx prisma/seed.ts --dry-run",
    "postinstall": "prisma generate",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx eval/run.ts",
    "eval:oracle": "tsx eval/run.ts --mode oracle",
    "eval:stub": "tsx eval/run.ts --mode dev-stub",
    "bench": "tsx eval/bench.ts",
    "bench:http": "tsx eval/httpBench.ts",
    "eval:perturbed": "tsx eval/run.ts --mode perturbed",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@langchain/openai": "1.6.2",
    "@prisma/client": "6.19.3",
    "csv-parse": "7.0.3",
    "jose": "6.2.12",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "js-tiktoken": "1.0.21",
    "jsdom": "26.1.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
